# Copy to .env. Keep this file and the OpenAI key on the server only.
OPENAI_API_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Enter the same random token in the Android app's broker settings.
ROADVOICE_CLIENT_TOKEN=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_DELEGATION_MODEL=gpt-5.6-terra
OPENAI_VOICE=marin
HOST=127.0.0.1
PORT=8787
# USB-only setup: keep HOST on loopback, then use adb reverse tcp:8787 tcp:8787.
# App server URL: http://127.0.0.1:8787. The phone and server still need internet
# access to OpenAI. Do not publish this local HTTP listener or create a tunnel.
