{
  "name": "roadvoice-voice",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "secrets": { "required": ["OPENAI_API_KEY", "ROADVOICE_CLIENT_TOKEN"] }
}
